# Copy to .env (local). On the server these live in /etc/dotmind/env (see HOSTING.md).
# Never commit real values.

# Public site URL (canonical links, sitemap, Open Graph). Defaults to https://dotmind.de in production.
# NEXT_PUBLIC_SITE_URL=https://dotmind.de

# Contact form — SMTP account of the mailbox reza@dotmind.de (values from your mail provider)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=reza@dotmind.de
SMTP_PASS=
# Optional: sender shown to customers and where inquiries arrive
MAIL_FROM="dotMind <reza@dotmind.de>"
MAIL_TO=reza@dotmind.de
